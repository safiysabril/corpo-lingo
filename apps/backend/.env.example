PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# AI Provider: groq | openai | ollama | gemini
AI_PROVIDER=groq
# Fallback provider used when the primary is rate-limited (429). Optional.
# Example: set FALLBACK_PROVIDER=ollama and point OLLAMA_HOST to a running instance.
FALLBACK_PROVIDER=
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# Redis — optional but recommended to cache translations and save AI API calls
# Local dev: redis://localhost:6379
# Railway: set automatically when you add a Redis service to your project
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Password reset ────────────────────────────────────────────────────────────
# Base URL used in reset links sent to users (no trailing slash)
APP_URL=http://localhost:5173

# SMTP credentials for sending password-reset emails.
# Leave ALL three blank to use Ethereal (https://ethereal.email) — a disposable
# test inbox that requires zero sign-up. A preview URL is printed to the console.
#
# Easiest free option for real email delivery → Resend (https://resend.com)
#   Free tier: 3 000 emails/month, 100/day. Sign up → copy API key → fill below.
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx   ← your Resend API key
#   SMTP_FROM=you@yourdomain.com
#
# Any standard SMTP provider (Gmail, Brevo, Mailgun, etc.) also works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
