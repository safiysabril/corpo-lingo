PORT=3000
NODE_ENV=development

# Database — PostgreSQL connection string (REQUIRED)
# Local dev: start the DB with `docker compose -f docker-compose.dev.yml up -d`,
# then this default just works. Railway/cloud: set automatically by the provider.
DATABASE_URL=postgresql://corpo:corpo@localhost:5432/corpo_lingo

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# AI Provider: groq | openai | ollama | gemini
AI_PROVIDER=groq
# Fallback provider used when the primary is rate-limited (429). Optional.
# Example: set FALLBACK_PROVIDER=ollama and point OLLAMA_HOST to a running instance.
FALLBACK_PROVIDER=
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# Redis — optional but recommended to cache translations and save AI API calls
# Local dev: redis://localhost:6379
# Railway: set automatically when you add a Redis service to your project
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Password reset ────────────────────────────────────────────────────────────
# Base URL used in reset links sent to users (no trailing slash)
APP_URL=http://localhost:5173

# Resend HTTP API — recommended for Railway and all cloud deployments.
# Uses HTTPS (port 443) so it is never blocked by network firewalls.
# Sign up at resend.com → free tier: 3 000 emails/month, 100/day.
# Leave blank in local dev to use Ethereal (preview URL printed to console).
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Corpo Lingo <noreply@yourdomain.com>

# ── Google sign-in (Authorization Code flow) ──────────────────────────────────
# OAuth 2.0 "Web application" credentials from Google Cloud Console.
# The frontend opens Google's popup and gets a short-lived authorization code,
# then posts it here; the backend exchanges it for tokens using the secret below.
# The secret NEVER leaves the backend (don't put it in any VITE_/frontend var).
# Add your frontend origin(s) under "Authorized JavaScript origins", e.g.
# http://localhost:5174 (no redirect URI needed — the popup flow uses postmessage).
# GOOGLE_CLIENT_ID is public and also goes in the frontend's VITE_GOOGLE_CLIENT_ID.
# Leave both blank to disable Google sign-in (backend 503, frontend hides button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
