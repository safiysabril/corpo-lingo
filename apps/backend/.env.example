PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Database (SQLite — path relative to where the server is launched)
DB_PATH=./data/corpo.db

# AI Provider: groq | openai | ollama
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Redis — optional but recommended to cache translations and save AI API calls
# Local dev: redis://localhost:6379
# Railway: set automatically when you add a Redis service to your project
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
