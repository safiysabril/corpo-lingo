# Frontend environment for apps/frontend (Vite reads .env at dev/build time).
# Copy to apps/frontend/.env and fill in.

# Google sign-in: the OAuth 2.0 "Web application" Client ID from Google Cloud Console.
# MUST match the backend's GOOGLE_CLIENT_ID. Add http://localhost:5173 (and your
# production origin) under "Authorized JavaScript origins" for that client.
# Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
